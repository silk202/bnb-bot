# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ── RPC overrides (optional) ────────────────────────────────────────────────
# Leave empty to use the verified public endpoints in src/chains/registry.
# A value here is used by the browser bundle, so it must start with VITE_.
# The site Worker also forwards the plain names from project settings to the
# page as a JSON block, so changing one does not require a rebuild.
VITE_RPC_BSC=
VITE_RPC_WS_BSC=
VITE_RPC_BSC_TESTNET=
VITE_RPC_WS_BSC_TESTNET=
VITE_RPC_ETHEREUM=
VITE_RPC_ETHEREUM_SEPOLIA=
VITE_RPC_ARBITRUM=
VITE_RPC_ARBITRUM_SEPOLIA=
VITE_RPC_POLYGON=
VITE_RPC_POLYGON_AMOY=
VITE_RPC_BASE=
VITE_RPC_WS_BASE=
VITE_RPC_BASE_SEPOLIA=
VITE_RPC_WS_BASE_SEPOLIA=
